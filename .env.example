# ============================================================
# FPU SCHOOL MANAGEMENT SYSTEM — Environment Configuration
# Copy this file to .env and fill in real values.
#   Windows : copy .env.example .env
#   Bash    : cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# CORE
# ------------------------------------------------------------
NODE_ENV=development
# PORT is injected by Render in production; only used locally.
PORT=3000

# Comma-separated list of allowed origins for CORS.
# In production set this to your real domain(s), e.g.
#   ALLOWED_ORIGINS=https://fpu-school-system.onrender.com,https://fedpolyugep.edu.ng
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# DATABASE — PostgreSQL 16
# ------------------------------------------------------------
# Local Docker Postgres (matches docker-compose.yml):
DATABASE_URL=postgresql://fpu_user:fpu_pass@localhost:5432/fpu_school_system

# Production (Neon Postgres) — example:
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/fpu_school_system?sslmode=require

# Set to "true" when connecting over the internet (Neon, Render, etc.)
# Local Docker -> false.   Neon/Render -> true.
DATABASE_SSL=false

# ------------------------------------------------------------
# AUTH / SECURITY
# ------------------------------------------------------------
BCRYPT_ROUNDS=10
SESSION_TTL_HOURS=72
APP_SECRET=change-me-to-a-long-random-string-in-production

# ------------------------------------------------------------
# EMAIL (Nodemailer)
# ------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="FPU School Management <no-reply@fedpolyugep.edu.ng>"
ADMIN_EMAIL=admin@fedpolyugep.edu.ng

# ------------------------------------------------------------
# INSTITUTION
# ------------------------------------------------------------
INSTITUTION_NAME=Federal Polytechnic Ugep
INSTITUTION_SHORT=FPU
INSTITUTION_MOTTO=Citadel of Technical Excellence
INSTITUTION_STATE=Cross River State
INSTITUTION_COUNTRY=Nigeria
INSTITUTION_WEBSITE=https://fedpolyugep.edu.ng
MATRIC_PREFIX=FPU


# ------------------------------------------------------------
# STUDENT PAYMENTS
# ------------------------------------------------------------
# Add the Paystack SECRET key in Render Environment (never commit
# a real key here). Use the test key for testing, then switch to
# the live secret key only after Paystack account approval.
PAYSTACK_SECRET_KEY=
APP_URL=https://fpu-school-systems.onrender.com
# Optional override; defaults to APP_URL/portal/payment-return.html
# PAYSTACK_CALLBACK_URL=

# ------------------------------------------------------------
# RATE LIMITS
# ------------------------------------------------------------
LOGIN_MAX=20
LOGIN_WINDOW_MIN=15
ADMIN_MAX=300
ADMIN_WINDOW_MIN=1
PUBLIC_MAX=60
PUBLIC_WINDOW_MIN=1

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
DEFAULT_MAX_UNITS=24
DB_DEBUG=false

# ------------------------------------------------------------
# FILE UPLOADS
# ------------------------------------------------------------
UPLOAD_DIR=public/uploads
MAX_UPLOAD_MB=5
