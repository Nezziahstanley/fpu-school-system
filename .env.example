# ============================================================
# FPU SCHOOL MANAGEMENT SYSTEM — Environment Configuration
# Copy this file to .env and fill in real values.
#   Windows : copy .env.example .env
#   Bash    : cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# CORE
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed origins for CORS.
# In production set this to your real domain(s), e.g.
#   ALLOWED_ORIGINS=https://fpu.onrender.com,https://fedpolyugep.edu.ng
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# DATABASE — PostgreSQL 16
# ------------------------------------------------------------
# Local Docker Postgres (matches docker-compose.yml):
DATABASE_URL=postgresql://fpu_user:fpu_pass@localhost:5432/fpu_school_system

# Production (Neon Postgres) — example:
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/fpu_school_system?sslmode=require

# Set to "true" when connecting over the internet (Neon, Render, etc.)
DATABASE_SSL=false

# ------------------------------------------------------------
# AUTH / SECURITY
# ------------------------------------------------------------
# How many bcrypt rounds to use when hashing passwords.
BCRYPT_ROUNDS=10

# How long session tokens are valid (in hours).
SESSION_TTL_HOURS=72

# Secret used to sign/derive any ancillary hashes (matric verifier, tokens).
APP_SECRET=change-me-to-a-long-random-string-in-production

# ------------------------------------------------------------
# EMAIL (Nodemailer)
# ------------------------------------------------------------
# Master switch. When false, all email sending is skipped silently.
EMAIL_ENABLED=false

# SMTP credentials (Gmail app password, Mailgun, Sendgrid SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# The "from" address that recipients will see.
EMAIL_FROM="FPU School Management <no-reply@fedpolyugep.edu.ng>"

# Where admin notification emails should be sent.
ADMIN_EMAIL=admin@fedpolyugep.edu.ng

# ------------------------------------------------------------
# INSTITUTION
# ------------------------------------------------------------
INSTITUTION_NAME=Federal Polytechnic Ugep
INSTITUTION_SHORT=FPU
INSTITUTION_MOTTO=Citadel of Technical Excellence
INSTITUTION_STATE=Cross River State
INSTITUTION_COUNTRY=Nigeria
INSTITUTION_WEBSITE=https://fedpolyugep.edu.ng

# Matric number prefix (first segment of FPU/SST/CST/ND/26/001)
MATRIC_PREFIX=FPU

# ------------------------------------------------------------
# RATE LIMITS (values are per window, windows in minutes)
# ------------------------------------------------------------
LOGIN_MAX=20
LOGIN_WINDOW_MIN=15

ADMIN_MAX=300
ADMIN_WINDOW_MIN=1

PUBLIC_MAX=60
PUBLIC_WINDOW_MIN=1

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
# Default maximum units a student may register per semester.
# This is ALSO stored in the settings table and read at runtime;
# this env value is only the bootstrap default.
DEFAULT_MAX_UNITS=24

# Enables verbose SQL logging from Drizzle (dev only).
DB_DEBUG=false

# ------------------------------------------------------------
# FILE UPLOADS
# ------------------------------------------------------------
# Directory (relative to project root) where passport photos are stored.
UPLOAD_DIR=public/uploads

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=5