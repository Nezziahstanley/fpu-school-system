/* ============================================================
   FEDERAL POLYTECHNIC UGEP — Admin Panel Stylesheet
   Full stylesheet — v5 (Complete with Users module + Security)
   ============================================================ */

/* ============================================================
   1. RESET + ROOT VARIABLES
   ============================================================ */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --fpu-primary:        #065f46;
  --fpu-primary-dark:   #054d38;
  --fpu-primary-light:  #ecfdf5;
  --fpu-accent:         #f59e0b;
  --fpu-accent-dark:    #d97706;
  --fpu-accent-light:   #fef3c7;
  --fpu-teal:           #0ea5e9;
  --fpu-bone:           #f8faf8;
  --fpu-ink:            #1f2937;
  --fpu-muted:          #6b7280;
  --fpu-border:         #e5e7eb;
  --fpu-radius-sm:      8px;
  --fpu-radius:         14px;
  --fpu-radius-lg:      20px;
  --fpu-shadow-sm:      0 1px 2px rgba(15, 23, 42, 0.04);
  --fpu-shadow:         0 6px 20px rgba(15, 23, 42, 0.08);
  --fpu-shadow-lg:      0 20px 40px rgba(15, 23, 42, 0.12);
  --font-heading:       "Poppins", "Inter", system-ui, sans-serif;
  --font-body:          "Inter", system-ui, Arial, sans-serif;
  --sidebar-w:          260px;
  --sidebar-collapsed:  64px;
  --topbar-h:           64px;
}

html, body { height: 100%; }

body {
  font-family: var(--font-body);
  background: #f1f5f9;
  color: var(--fpu-ink);
  line-height: 1.6;
  font-size: 14.5px;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img, svg, video { max-width: 100%; height: auto; display: block; }
a { color: inherit; text-decoration: none; }
button { font: inherit; cursor: pointer; }

/* ============================================================
   2. TYPOGRAPHY
   ============================================================ */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  color: var(--fpu-ink);
  line-height: 1.3;
  font-weight: 600;
}

h1 { font-size: 1.4rem; }
h2 { font-size: 1.2rem; }
h3 { font-size: 1rem; }

p { margin: 0 0 1rem; }
p:last-child { margin-bottom: 0; }

.muted { color: var(--fpu-muted); }
.small { font-size: 13px; }
.small.muted { font-size: 12px; color: var(--fpu-muted); }
.tiny { font-size: 11.5px; }
.bold { font-weight: 700; }
.uppercase { text-transform: uppercase; letter-spacing: 0.5px; }

/* ============================================================
   3. ADMIN SHELL LAYOUT
   ============================================================ */
body.admin-app {
  min-height: 100vh;
  background: #f1f5f9;
}

/* ============================================================
   4. SIDEBAR
   ============================================================ */
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: var(--sidebar-w);
  background: linear-gradient(180deg, #053d13 0%, #065f46 100%);
  color: #d1fae5;
  display: flex;
  flex-direction: column;
  z-index: 900;
  transition: width 0.2s ease, transform 0.2s ease;
  overflow: hidden;
}

.sidebar .brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 20px;
  height: var(--topbar-h);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
  color: #ffffff;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 15px;
  white-space: nowrap;
}

.sidebar .brand img {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.1);
}

.sidebar nav {
  flex: 1;
  overflow-y: auto;
  padding: 12px 8px 24px;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
}

.sidebar nav::-webkit-scrollbar { width: 6px; }
.sidebar nav::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3px;
}

.sidebar .section-title {
  font-family: var(--font-heading);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #6ee7b7;
  padding: 16px 14px 8px;
  white-space: nowrap;
  overflow: hidden;
}

.sidebar .nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  margin: 1px 4px;
  border-radius: 8px;
  color: #d1fae5;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  transition: background 0.15s ease, color 0.15s ease;
  text-decoration: none;
}

.sidebar .nav-item:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
}

.sidebar .nav-item.active {
  background: #047857;
  color: #ffffff;
  font-weight: 600;
}

.sidebar .nav-item .icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.sidebar .nav-item .icon svg {
  width: 18px;
  height: 18px;
  stroke: currentColor;
}

.sidebar .nav-item .label {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar .nav-item .badge-dot {
  background: var(--fpu-accent);
  color: #1f2937;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 999px;
  margin-left: auto;
}

.sidebar .loading {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 20px 14px;
  color: #a7f3d0;
  font-size: 13.5px;
}

.sidebar-footer {
  padding: 14px 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11.5px;
  color: #6ee7b7;
  flex-shrink: 0;
  white-space: nowrap;
}

body.sidebar-collapsed .sidebar { width: var(--sidebar-collapsed); }
body.sidebar-collapsed .sidebar .brand span,
body.sidebar-collapsed .sidebar .nav-item .label,
body.sidebar-collapsed .sidebar .nav-item .badge-dot,
body.sidebar-collapsed .sidebar .section-title { display: none; }
body.sidebar-collapsed .sidebar .brand { justify-content: center; padding: 0; }
body.sidebar-collapsed .sidebar .nav-item { justify-content: center; padding: 11px 8px; }
body.sidebar-collapsed .sidebar-footer { justify-content: center; padding: 14px 8px; }
body.sidebar-collapsed .sidebar-footer span:last-child { display: none; }

/* ============================================================
   5. TOPBAR
   ============================================================ */
.topbar {
  position: sticky;
  top: 0;
  z-index: 800;
  margin-left: var(--sidebar-w);
  height: var(--topbar-h);
  background: #ffffff;
  border-bottom: 1px solid var(--fpu-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  gap: 16px;
  transition: margin-left 0.2s ease;
}

body.sidebar-collapsed .topbar { margin-left: var(--sidebar-collapsed); }

.topbar-left {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.topbar-left .toggle {
  background: transparent;
  border: none;
  padding: 6px;
  border-radius: 8px;
  color: #475569;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}

.topbar-left .toggle:hover { background: #f1f5f9; }

.topbar-left h1 {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: #0f172a;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.topbar-left .subtitle {
  font-size: 12px;
  color: var(--fpu-muted);
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.icon-btn {
  background: #f8fafc;
  border: 1px solid var(--fpu-border);
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #475569;
  position: relative;
  transition: background 0.15s ease;
}

.icon-btn:hover {
  background: #f1f5f9;
  color: var(--fpu-primary);
}

.icon-btn .dot {
  position: absolute;
  top: -2px;
  right: -2px;
  min-width: 18px;
  height: 18px;
  background: #dc2626;
  color: #ffffff;
  border-radius: 999px;
  font-size: 10.5px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 14px 5px 5px;
  border-radius: 999px;
  background: #f8fafc;
  border: 1px solid var(--fpu-border);
  cursor: pointer;
  transition: background 0.15s ease;
}

.user-chip:hover { background: #f1f5f9; }

.user-chip .avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, #065f46, #f59e0b);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
  font-size: 12.5px;
  font-weight: 700;
  overflow: hidden;
  flex-shrink: 0;
}

.user-chip .avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.user-chip .name {
  font-size: 13px;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.2;
  white-space: nowrap;
}

.user-chip .role {
  font-size: 10.5px;
  color: var(--fpu-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  line-height: 1.2;
}

/* ============================================================
   6. MAIN CONTENT
   ============================================================ */
.main {
  margin-left: var(--sidebar-w);
  padding: 24px 28px 40px;
  min-height: calc(100vh - var(--topbar-h));
  transition: margin-left 0.2s ease;
}

body.sidebar-collapsed .main { margin-left: var(--sidebar-collapsed); }

/* ============================================================
   7. PAGE HEADERS
   ============================================================ */
.page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.page-head h2 {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 700;
  color: #0f172a;
  margin: 0 0 4px;
}

.page-head .muted { font-size: 13px; }

.page-head .actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

/* ============================================================
   8. STAT TILES
   ============================================================ */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

.stat {
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-radius: 12px;
  padding: 18px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  box-shadow: var(--fpu-shadow-sm);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.stat:hover {
  transform: translateY(-2px);
  box-shadow: var(--fpu-shadow);
}

.stat .meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.stat .label {
  font-family: var(--font-heading);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--fpu-muted);
}

.stat .value {
  font-family: var(--font-heading);
  font-size: 1.85rem;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.stat .ic {
  width: 46px;
  height: 46px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--fpu-primary-light);
  color: var(--fpu-primary);
  font-size: 1.4rem;
  flex-shrink: 0;
}

.stat.accent .ic { background: var(--fpu-accent-light); color: var(--fpu-accent-dark); }
.stat.blue   .ic { background: #dbeafe; color: #1e40af; }
.stat.red    .ic { background: #fee2e2; color: #991b1b; }
.stat.purple .ic { background: #ede9fe; color: #6d28d9; }

/* ============================================================
   9. PANELS
   ============================================================ */
.panel {
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-radius: 14px;
  box-shadow: var(--fpu-shadow-sm);
  margin-bottom: 20px;
  overflow: hidden;
}

.panel-head {
  padding: 16px 20px;
  border-bottom: 1px solid var(--fpu-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.panel-head h3 {
  font-family: var(--font-heading);
  font-size: 14.5px;
  font-weight: 700;
  color: #0f172a;
  margin: 0;
}

.panel-head .tools {
  display: flex;
  gap: 8px;
  align-items: center;
}

.panel-body {
  padding: 20px;
}

.panel-body.flush {
  padding: 0;
}

/* ============================================================
   10. BUTTONS
   ============================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 9px 18px;
  border-radius: 8px;
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.3px;
  border: 1px solid transparent;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.15s ease;
  white-space: nowrap;
  line-height: 1.2;
}

.btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.btn-primary {
  background: var(--fpu-primary);
  color: #ffffff;
  border-color: var(--fpu-primary);
}
.btn-primary:hover:not(:disabled) {
  background: var(--fpu-primary-dark);
  border-color: var(--fpu-primary-dark);
}

.btn-accent {
  background: var(--fpu-accent);
  color: #1f2937;
  border-color: var(--fpu-accent);
}
.btn-accent:hover:not(:disabled) {
  background: var(--fpu-accent-dark);
  border-color: var(--fpu-accent-dark);
  color: #ffffff;
}

.btn-outline {
  background: #ffffff;
  color: var(--fpu-primary);
  border-color: var(--fpu-primary);
}
.btn-outline:hover:not(:disabled) {
  background: var(--fpu-primary-light);
}

.btn-ghost {
  background: transparent;
  color: #475569;
  border-color: transparent;
}
.btn-ghost:hover:not(:disabled) {
  background: #f1f5f9;
}

.btn-danger {
  background: #dc2626;
  color: #ffffff;
  border-color: #dc2626;
}
.btn-danger:hover:not(:disabled) {
  background: #b91c1c;
  border-color: #b91c1c;
}

.btn-sm { padding: 6px 12px; font-size: 12px; }
.btn-lg { padding: 12px 24px; font-size: 14px; }
.btn-block { width: 100%; }

/* ============================================================
   11. FORMS
   ============================================================ */
.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 640px) {
  .form-row { grid-template-columns: 1fr; gap: 0; }
}

.form-group {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  margin-bottom: 6px;
  font-family: var(--font-heading);
  font-size: 12.5px;
  font-weight: 600;
  color: #334155;
}

.form-label .req { color: #dc2626; margin-left: 2px; }

.form-control,
.form-select,
textarea.form-control {
  width: 100%;
  padding: 10px 14px;
  border: 1.5px solid var(--fpu-border);
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  color: #0f172a;
  background: #ffffff;
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.form-control:hover,
.form-select:hover { border-color: #cbd5e1; }

.form-control:focus,
.form-select:focus,
textarea.form-control:focus {
  border-color: var(--fpu-primary);
  box-shadow: 0 0 0 4px rgba(6, 95, 70, 0.12);
}

textarea.form-control { resize: vertical; min-height: 90px; }

.form-help {
  font-size: 12px;
  color: var(--fpu-muted);
  margin-top: 4px;
}

.form-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.filters {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: flex-end;
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-radius: 12px;
  padding: 14px 18px;
  margin-bottom: 20px;
}

.filters .form-group { margin-bottom: 0; flex: 1 1 180px; min-width: 160px; }

/* ============================================================
   12. TABLES
   ============================================================ */
.table-wrap {
  width: 100%;
  overflow-x: auto;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13.5px;
  min-width: 640px;
}

.data-table thead { background: #f8fafc; }

.data-table th {
  text-align: left;
  padding: 12px 16px;
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: #64748b;
  border-bottom: 1px solid var(--fpu-border);
  white-space: nowrap;
}

.data-table td {
  padding: 12px 16px;
  border-bottom: 1px solid #f1f5f9;
  color: #1e293b;
  vertical-align: middle;
}

.data-table tbody tr:hover { background: #f8fafc; }
.data-table tbody tr:last-child td { border-bottom: none; }

.data-table td.num { text-align: right; font-variant-numeric: tabular-nums; }

.data-table code {
  background: #f1f5f9;
  padding: 2px 8px;
  border-radius: 4px;
  font-family: "Courier New", monospace;
  font-size: 12.5px;
  color: var(--fpu-primary);
  font-weight: 600;
}

.data-table .empty {
  text-align: center;
  padding: 30px 16px;
  color: #94a3b8;
  font-size: 13.5px;
  font-style: italic;
}

/* .table-admin — alias of .data-table for admin partials */
.table-admin {
  width: 100%;
  border-collapse: collapse;
  font-size: 13.5px;
  min-width: 640px;
}
.table-admin thead { background: #f8fafc; }
.table-admin th {
  text-align: left;
  padding: 12px 16px;
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: #64748b;
  border-bottom: 1px solid var(--fpu-border);
  white-space: nowrap;
}
.table-admin td {
  padding: 12px 16px;
  border-bottom: 1px solid #f1f5f9;
  color: #1e293b;
  vertical-align: middle;
}
.table-admin tbody tr:hover { background: #f8fafc; }
.table-admin tbody tr:last-child td { border-bottom: none; }
.table-admin td.num { text-align: right; font-variant-numeric: tabular-nums; }
.table-admin code {
  background: #f1f5f9;
  padding: 2px 8px;
  border-radius: 4px;
  font-family: "Courier New", monospace;
  font-size: 12.5px;
  color: var(--fpu-primary);
  font-weight: 600;
}
.table-admin .empty {
  text-align: center;
  padding: 30px 16px;
  color: #94a3b8;
  font-size: 13.5px;
  font-style: italic;
}

/* ============================================================
   13. BADGES + PILLS + TAGS
   ============================================================ */
.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-family: var(--font-heading);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  line-height: 1.5;
  white-space: nowrap;
}

.badge-primary { background: #d1fae5; color: #065f46; }
.badge-info    { background: #dbeafe; color: #1e40af; }
.badge-warning { background: #fef3c7; color: #92400e; }
.badge-danger  { background: #fee2e2; color: #991b1b; }
.badge-success { background: #dcfce7; color: #15803d; }
.badge-muted   { background: #f3f4f6; color: #4b5563; }

.tag-pill {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 600;
  background: var(--fpu-primary-light);
  color: var(--fpu-primary);
  margin: 2px 4px 2px 0;
}

.tag-pill.gold { background: var(--fpu-accent-light); color: var(--fpu-accent-dark); }

/* ============================================================
   13b. ROLE BADGES (used on Users pages)
   ============================================================ */
.badge.role-student   { background: #dbeafe; color: #1e40af; }
.badge.role-lecturer  { background: #d1fae5; color: #065f46; }
.badge.role-hod       { background: #ede9fe; color: #6d28d9; }
.badge.role-admin     { background: #065f46; color: #ffffff; }
.badge.role-bursar,
.badge.role-registrar,
.badge.role-rector,
.badge.role-librarian,
.badge.role-exam_officer,
.badge.role-academic_officer,
.badge.role-admission_officer {
  background: #fef3c7; color: #92400e;
}

/* ============================================================
   14. ALERTS
   ============================================================ */
.alert {
  padding: 12px 16px;
  border-radius: 10px;
  margin-bottom: 16px;
  font-size: 13.5px;
  line-height: 1.6;
  border-left: 4px solid transparent;
}

.alert-info {
  background: #eff6ff;
  border-color: #3b82f6;
  color: #1e40af;
}

.alert-success {
  background: #ecfdf5;
  border-color: #065f46;
  color: #065f46;
}

.alert-warning {
  background: #fffbeb;
  border-color: #f59e0b;
  color: #92400e;
}

.alert-error,
.alert-danger {
  background: #fef2f2;
  border-color: #dc2626;
  color: #991b1b;
}

.alert.alert-warning.partial-error-banner,
.alert.alert-warning.portal-error-banner {
  border-left-width: 4px;
}

/* ============================================================
   15. MODAL
   ============================================================ */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  display: none;
  z-index: 2000;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal-backdrop.open { display: flex; }

.modal {
  background: #ffffff;
  border-radius: 14px;
  box-shadow: var(--fpu-shadow-lg);
  width: 100%;
  max-width: 640px;
  max-height: 90vh;
  overflow-y: auto;
}

.modal-head {
  padding: 16px 20px;
  border-bottom: 1px solid var(--fpu-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.modal-head h3 {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  margin: 0;
}

.modal-body { padding: 20px; }
.modal-foot {
  padding: 14px 20px;
  background: #f8fafc;
  border-top: 1px solid var(--fpu-border);
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

/* ============================================================
   16. TOAST
   ============================================================ */
.toast-wrap {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 3000;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}

.toast {
  pointer-events: auto;
  min-width: 260px;
  max-width: 380px;
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-left: 4px solid var(--fpu-primary);
  border-radius: 10px;
  padding: 12px 16px;
  box-shadow: var(--fpu-shadow);
  font-size: 13.5px;
  color: #1e293b;
  animation: toast-in 0.2s ease;
}

.toast.success { border-left-color: #059669; }
.toast.error   { border-left-color: #dc2626; }
.toast.warning { border-left-color: #f59e0b; }

@keyframes toast-in {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ============================================================
   17. TABS
   ============================================================ */
.tabs {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid var(--fpu-border);
  margin-bottom: 20px;
  overflow-x: auto;
}

.tab {
  padding: 10px 16px;
  border: none;
  background: transparent;
  color: #64748b;
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: color 0.15s ease, border-color 0.15s ease;
  white-space: nowrap;
}

.tab:hover { color: var(--fpu-primary); }
.tab.active {
  color: var(--fpu-primary);
  border-bottom-color: var(--fpu-primary);
}

/* ============================================================
   18. PAGINATION
   ============================================================ */
.pagination {
  display: flex;
  gap: 4px;
  justify-content: center;
  padding: 16px;
  flex-wrap: wrap;
}

.pagination button {
  padding: 6px 12px;
  border: 1px solid var(--fpu-border);
  background: #ffffff;
  border-radius: 6px;
  font-size: 13px;
  color: #475569;
  cursor: pointer;
  transition: all 0.15s ease;
}

.pagination button:hover { background: #f8fafc; }

.pagination button.active {
  background: var(--fpu-primary);
  color: #ffffff;
  border-color: var(--fpu-primary);
}

.pagination button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.pagination-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 12px 20px;
  border-top: 1px solid var(--fpu-border);
  background: #f8fafc;
  font-size: 13px;
  color: var(--fpu-muted);
  flex-wrap: wrap;
}
.pagination-bar .pg-info { flex: 1; min-width: 140px; }
.pagination-bar .pg-controls {
  display: flex;
  gap: 4px;
  align-items: center;
}
.pagination-bar button {
  min-width: 34px;
  height: 34px;
  border: 1px solid var(--fpu-border);
  background: #ffffff;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #475569;
  cursor: pointer;
  transition: all 0.15s ease;
}
.pagination-bar button:hover:not(:disabled) {
  background: var(--fpu-primary-light);
  border-color: var(--fpu-primary);
  color: var(--fpu-primary);
}
.pagination-bar button.active {
  background: var(--fpu-primary);
  border-color: var(--fpu-primary);
  color: #ffffff;
}
.pagination-bar button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* ============================================================
   19. LOADING STATES
   ============================================================ */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 30px 16px;
  color: #64748b;
  font-size: 13.5px;
}

.spinner {
  display: inline-block;
  width: 18px;
  height: 18px;
  border: 2px solid #e2e8f0;
  border-top-color: var(--fpu-primary);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* Skeleton loaders */
.skeleton {
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s infinite;
  border-radius: 4px;
  height: 14px;
  margin: 6px 0;
}
.skeleton.w-30 { width: 30%; }
.skeleton.w-50 { width: 50%; }
.skeleton.w-80 { width: 80%; }
.skeleton.w-100 { width: 100%; }
@keyframes skeleton-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============================================================
   20. EMPTY STATES
   ============================================================ */
.empty-state {
  text-align: center;
  padding: 40px 20px;
  color: #94a3b8;
}

.empty-state .icon {
  font-size: 2.5rem;
  margin-bottom: 10px;
  opacity: 0.6;
}

.empty-state p {
  font-size: 14px;
  margin: 0;
}

/* ============================================================
   21. CHART CARDS (DASHBOARD)
   ============================================================ */
.chart-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 20px;
}

.chart-card {
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-radius: 14px;
  padding: 20px;
  box-shadow: var(--fpu-shadow-sm);
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.chart-card:hover {
  box-shadow: var(--fpu-shadow);
  border-color: rgba(6, 95, 70, 0.2);
}

.chart-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 2px solid #f1f5f9;
  flex-wrap: wrap;
}

.chart-card-header h3 {
  font-family: var(--font-heading);
  font-size: 12.5px;
  font-weight: 700;
  color: #0f172a;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.6px;
}

.chart-badge {
  background: var(--fpu-primary-light);
  color: var(--fpu-primary);
  font-family: var(--font-heading);
  font-size: 10px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 999px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.chart-body {
  position: relative;
  height: 260px;
}

.chart-body canvas {
  max-height: 260px;
}

/* ============================================================
   22. PROGRESS LIST ITEMS
   ============================================================ */
.progress-list-item {
  margin-bottom: 16px;
}

.progress-list-item:last-child { margin-bottom: 0; }

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #0f172a;
  gap: 8px;
}

.progress-header .progress-value {
  color: var(--fpu-primary);
  font-weight: 700;
  flex-shrink: 0;
}

.progress-bar {
  background: #f1f5f9;
  height: 8px;
  border-radius: 999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--fpu-primary) 0%, #22c55e 100%);
  transition: width 0.8s ease;
}

.progress-fill.gold {
  background: linear-gradient(90deg, var(--fpu-accent-dark) 0%, var(--fpu-accent) 100%);
}

/* ============================================================
   23. ACTIVITY FEED
   ============================================================ */
.activity-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #f1f5f9;
}
.activity-item:last-child { border-bottom: none; }

.activity-icon {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border-radius: 50%;
  background: var(--fpu-primary-light);
  color: var(--fpu-primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
}

.activity-content {
  flex: 1;
  min-width: 0;
}
.activity-content strong {
  display: block;
  font-size: 13.5px;
  color: #0f172a;
  font-family: var(--font-heading);
  font-weight: 600;
  line-height: 1.35;
}
.activity-content p {
  margin: 2px 0 0;
  font-size: 12.5px;
  color: var(--fpu-muted);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-time {
  font-size: 11.5px;
  color: #94a3b8;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ============================================================
   24. SESSION ITEMS
   ============================================================ */
.session-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid var(--fpu-border);
  border-radius: 8px;
  background: #ffffff;
  margin-bottom: 8px;
  transition: border-color 0.15s ease, background 0.15s ease;
}
.session-item:last-child { margin-bottom: 0; }
.session-item:hover { border-color: #cbd5e1; }

.session-item.current {
  border-color: #10b981;
  background: #ecfdf5;
}

.session-item .meta {
  flex: 1;
  min-width: 0;
  font-size: 13.5px;
  line-height: 1.5;
  color: #334155;
}
.session-item .meta strong {
  display: block;
  color: #0f172a;
  font-family: var(--font-heading);
  font-size: 13.5px;
  font-weight: 600;
  margin-bottom: 2px;
}
.session-item .meta p { margin: 0; }
.session-item .small { font-size: 12px; }
.session-item .muted { color: var(--fpu-muted); }

/* ============================================================
   25. ROW ACTIONS
   ============================================================ */
.row-actions {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  align-items: center;
}
.row-actions .btn { padding: 5px 10px; font-size: 11.5px; }

/* ============================================================
   26. GRID UTILITIES
   ============================================================ */
.grid {
  display: grid;
  gap: 16px;
}
.grid-2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
.grid-3 { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
.grid-4 { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }

@media (max-width: 640px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}

/* ============================================================
   27. PERSON / PHOTO GRID
   ============================================================ */
.person {
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-radius: 12px;
  padding: 20px 16px;
  text-align: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.person:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
}
.person .photo {
  width: 84px;
  height: 84px;
  margin: 0 auto 12px;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, var(--fpu-primary), var(--fpu-accent));
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 700;
}
.person .photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.person h4 {
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  margin: 0 0 4px;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.person .role {
  font-size: 12px;
  color: var(--fpu-muted);
  text-transform: capitalize;
}

/* ============================================================
   28. RESULT GRADES
   ============================================================ */
.result-table th, .result-table td { padding: 10px 14px; }
.result-table .grade {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  font-weight: 800;
  font-size: 12.5px;
  background: #ecfdf5;
  color: #065f46;
  font-family: var(--font-heading);
}
.result-table .grade.F { background: #fee2e2; color: #991b1b; }
.result-table .grade.D,
.result-table .grade.E { background: #fef3c7; color: #92400e; }

/* ============================================================
   29. SMALL HELPERS
   ============================================================ */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}
.mt-3 { margin-top: 16px; }
.mt-4 { margin-top: 24px; }

/* ============================================================
   30. PRINT
   ============================================================ */
.print-only { display: none; }

@media print {
  .sidebar,
  .topbar,
  .filters,
  .pagination-bar,
  .row-actions,
  .page-head .actions,
  .toast-wrap,
  .modal-backdrop,
  .partial-error-banner { display: none !important; }

  .main { margin: 0 !important; padding: 0 !important; }
  .panel { box-shadow: none !important; border: 1px solid #ccc !important; break-inside: avoid; }
  .panel-head { background: #f8fafc !important; }

  body { background: #fff !important; font-size: 11pt; }
  a { color: #000 !important; text-decoration: none; }
  .table-admin, .data-table { font-size: 10pt; }
  .table-admin th, .data-table th { background: #f1f5f9 !important; }

  .print-only { display: block; margin-top: 24px; font-size: 10pt; color: #666; text-align: center; }
}

/* ============================================================
   PROFILE DROPDOWN (topbar)
   ============================================================ */
.user-chip-wrap {
  position: relative;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 12px 5px 5px;
  border-radius: 999px;
  background: #f8fafc;
  border: 1px solid var(--fpu-border);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
  user-select: none;
}

.user-chip:hover,
.user-chip[aria-expanded="true"] {
  background: #f1f5f9;
  border-color: #cbd5e1;
}

.user-chip:focus-visible {
  outline: 2px solid var(--fpu-primary);
  outline-offset: 2px;
}

.user-chip .chev {
  color: #94a3b8;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.user-chip[aria-expanded="true"] .chev {
  transform: rotate(180deg);
}

.user-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 260px;
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-radius: 12px;
  box-shadow: 0 16px 40px rgba(15, 23, 42, 0.15);
  padding: 6px;
  z-index: 1000;
  animation: user-menu-in 0.15s ease;
}

.user-menu[hidden] { display: none; }

@keyframes user-menu-in {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}

.user-menu-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 12px 10px;
}

.user-menu-header .avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #065f46, #f59e0b);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  overflow: hidden;
  flex-shrink: 0;
}

.user-menu-header .avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.user-menu-header .name {
  font-size: 13.5px;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180px;
}

.user-menu-header .email {
  font-size: 11.5px;
  color: var(--fpu-muted);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180px;
}

.user-menu-divider {
  height: 1px;
  background: var(--fpu-border);
  margin: 4px 6px;
}

.user-menu-item {
  display: block;
  width: 100%;
  text-align: left;
  padding: 9px 12px;
  border-radius: 7px;
  border: none;
  background: transparent;
  font-family: var(--font-body);
  font-size: 13.5px;
  color: #1e293b;
  cursor: pointer;
  transition: background 0.12s ease;
}

.user-menu-item:hover,
.user-menu-item:focus-visible {
  background: #f1f5f9;
  outline: none;
}

.user-menu-item.user-menu-danger {
  color: #b91c1c;
}

.user-menu-item.user-menu-danger:hover {
  background: #fef2f2;
}

/* ============================================================
   APPLICATIONS MODULE
   ============================================================ */

/* ---------- Inline stats ---------- */
.stats-inline {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

.stat-inline {
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-left: 4px solid #64748b;
  border-radius: 10px;
  padding: 12px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-inline .label {
  font-family: var(--font-heading);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: var(--fpu-muted);
}

.stat-inline .value {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 800;
  color: #0f172a;
  line-height: 1;
}

.stat-inline-accent   { border-left-color: #f59e0b; }
.stat-inline-success  { border-left-color: #10b981; }
.stat-inline-primary  { border-left-color: #065f46; }

/* ---------- Bulk action bar ---------- */
.bulk-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  background: #ffffff;
  border: 1px solid var(--fpu-border);
  border-radius: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.bulk-actions {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

/* ---------- Applicant cell (avatar + name + email) ---------- */
.applicant-cell {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.applicant-avatar {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #065f46, #f59e0b);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
}

.applicant-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.applicant-name {
  font-family: var(--font-heading);
  font-size: 13.5px;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 220px;
}

.applicant-meta {
  font-size: 12px;
  color: var(--fpu-muted);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 220px;
}

/* ---------- Clickable rows ---------- */
tr.row-clickable {
  cursor: pointer;
  transition: background 0.12s ease;
}
tr.row-clickable:hover {
  background: #f1f5f9;
}
tr.row-clickable:hover td:first-child {
  background: #f1f5f9;
}

/* ---------- Selection checkbox ---------- */
.app-check,
#apps-select-all {
  width: 16px;
  height: 16px;
  accent-color: var(--fpu-primary);
  cursor: pointer;
}

/* ---------- Mobile tweaks ---------- */
@media (max-width: 640px) {
  .applicant-name,
  .applicant-meta { max-width: 140px; }
  .bulk-bar { flex-direction: column; align-items: stretch; }
  .bulk-actions { justify-content: stretch; }
  .bulk-actions .btn { flex: 1; }
}

/* ============================================================
   TIMETABLE A4 SHEET — print-friendly
   ============================================================ */
.tt-sheet {
  width: 210mm;
  min-height: 297mm;
  margin: 0 auto 24px;
  padding: 10mm;
  background: #fff;
  box-shadow: 0 4px 20px rgba(15,23,42,0.12);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: 'Inter', sans-serif;
  color: #0f172a;
}

.tt-letterhead {
  text-align: center;
  padding-bottom: 8mm;
  border-bottom: 2px solid #065f46;
  margin-bottom: 6mm;
}
.tt-letterhead h1 {
  font-family: 'Poppins', sans-serif;
  font-size: 18pt;
  color: #065f46;
  margin: 0 0 2mm;
  letter-spacing: 0.5px;
}
.tt-letterhead .motto {
  font-style: italic;
  color: #6b7280;
  font-size: 9pt;
  margin-bottom: 3mm;
}
.tt-letterhead .tt-doc-type {
  display: inline-block;
  background: #ecfdf5;
  color: #065f46;
  font-family: 'Poppins', sans-serif;
  font-size: 8pt;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 2mm 6mm;
  border-radius: 999px;
}

.tt-meta {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 3mm;
  margin-bottom: 5mm;
  padding: 3mm 4mm;
  background: #f8fafc;
  border-radius: 2mm;
  font-size: 9pt;
}
.tt-meta-item { display: flex; flex-direction: column; gap: 0.5mm; }
.tt-meta-item .k {
  font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.5px;
  color: #6b7280; font-weight: 700;
}
.tt-meta-item .v {
  font-family: 'Poppins', sans-serif; font-weight: 700; color: #0f172a;
}

.tt-grid-wrap { flex: 1; overflow: hidden; }
.tt-grid {
  display: grid;
  grid-template-columns: 22mm repeat(6, 1fr);
  border-top: 1px solid #cbd5e1;
  border-left: 1px solid #cbd5e1;
  font-size: 7.5pt;
  line-height: 1.3;
}
.tt-grid > div {
  border-right: 1px solid #cbd5e1;
  border-bottom: 1px solid #cbd5e1;
  padding: 1mm 1.5mm;
  min-height: 6.5mm;
  box-sizing: border-box;
  overflow: hidden;
}
.tt-grid .tt-col-head {
  background: #065f46; color: #fff;
  font-family: 'Poppins', sans-serif; font-weight: 700;
  text-align: center; font-size: 8.5pt;
  letter-spacing: 0.5px; padding: 2mm 1mm;
}
.tt-grid .tt-time-head {
  background: #047857; color: #fff;
  font-family: 'Poppins', sans-serif; font-weight: 700;
  text-align: center; font-size: 8pt;
}
.tt-grid .tt-time-cell {
  background: #f8fafc; text-align: right;
  font-family: 'Courier New', monospace;
  font-size: 7pt; color: #475569;
  padding-right: 2mm; font-weight: 700;
}
.tt-grid .tt-slot-cell { background: #fff; }
.tt-grid .tt-slot-cell.occupied {
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
  border-left: 2px solid #065f46;
  padding: 1.5mm 2mm;
}
.tt-grid .tt-slot-cell.conflict {
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  border-left: 2px solid #dc2626;
}

.tt-slot-block { display: flex; flex-direction: column; gap: 0.5mm; }
.tt-slot-block .code {
  font-family: 'Poppins', sans-serif; font-weight: 800;
  color: #065f46; font-size: 8pt; letter-spacing: 0.3px;
}
.tt-slot-block .title {
  font-size: 6.8pt; color: #334155; font-weight: 500; line-height: 1.2;
}
.tt-slot-block .meta {
  font-size: 6.5pt; color: #64748b; margin-top: 0.5mm;
}
.tt-slot-block .meta strong { color: #f59e0b; font-weight: 700; }

.tt-foot {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 4mm; border-top: 1px solid #cbd5e1;
  margin-top: 5mm; font-size: 7.5pt; color: #6b7280;
}
.tt-foot .tt-foot-sig {
  display: flex; gap: 12mm;
  font-family: 'Poppins', sans-serif; font-weight: 700;
  color: #065f46; font-size: 8pt;
}
.tt-foot .tt-foot-sig span {
  border-top: 1px solid #94a3b8; padding-top: 1mm;
  min-width: 40mm; text-align: center;
  font-weight: 600; color: #475569;
}

.tt-summary {
  margin-top: 5mm;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3mm;
  font-size: 8.5pt;
}
.tt-summary-item {
  background: #f8fafc;
  padding: 2.5mm 3mm;
  border-radius: 2mm;
  text-align: center;
}
.tt-summary-item .label {
  font-size: 7pt; text-transform: uppercase;
  letter-spacing: 0.5px; color: #6b7280;
  font-weight: 700; margin-bottom: 1mm;
}
.tt-summary-item .value {
  font-family: 'Poppins', sans-serif;
  font-size: 12pt; font-weight: 800;
  color: #065f46; line-height: 1;
}

@media print {
  @page { size: A4 portrait; margin: 0; }
  .tt-sheet {
    box-shadow: none; margin: 0;
    page-break-after: always;
  }
  .tt-sheet:last-child { page-break-after: auto; }
}

/* ============================================================
   EXAM SHEET — A4 landscape
   ============================================================ */
.ex-sheet {
  width: 297mm;
  min-height: 210mm;
  margin: 0 auto 24px;
  padding: 8mm;
  background: #fff;
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.12);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: 'Inter', Arial, sans-serif;
  color: #000;
  position: relative;
}

.ex-head {
  display: flex;
  align-items: flex-start;
  gap: 6mm;
  margin-bottom: 4mm;
}
.ex-head-logo {
  width: 20mm; height: 20mm;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.ex-head-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
.ex-head-text { flex: 1; text-align: center; }
.ex-head-text .institution {
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 12pt; font-weight: 700; color: #000;
  letter-spacing: 0.3px; line-height: 1.15; text-transform: uppercase;
}
.ex-head-text .faculty {
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 11pt; font-weight: 700; color: #000;
  letter-spacing: 0.3px; text-transform: uppercase; margin-top: 1.5mm;
}
.ex-head-text .title-line {
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 11pt; font-weight: 700; color: #000;
  letter-spacing: 0.3px; text-transform: uppercase; margin-top: 1.5mm;
}
.ex-head-text .level-line {
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 9.5pt; font-weight: 600; color: #333; margin-top: 2mm;
}
.ex-draft-badge {
  position: absolute;
  top: 8mm; right: 8mm;
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 8pt; font-weight: 700;
  letter-spacing: 0.8px; text-transform: uppercase; color: #000;
}

.ex-table { width: 100%; border-collapse: collapse; font-size: 7.5pt; line-height: 1.25; margin-top: 2mm; }
.ex-table th {
  border: 1px solid #000; background: #fff;
  padding: 2mm 1mm;
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 7.5pt; font-weight: 700; color: #000;
  text-align: center; vertical-align: middle; text-transform: uppercase;
}
.ex-table td { border: 1px solid #000; padding: 1.5mm 1.5mm; vertical-align: top; font-size: 7.5pt; }
.ex-table .col-days { width: 11mm; text-align: center; font-family: 'Poppins', Arial, sans-serif; font-weight: 700; font-size: 8pt; background: #fafafa; }
.ex-table .col-date { width: 15mm; text-align: center; font-size: 7.5pt; font-weight: 600; }
.ex-table .col-period { width: 22%; }

.ex-cell-course {
  font-family: 'Poppins', Arial, sans-serif;
  font-weight: 700; font-size: 7.5pt; color: #000; line-height: 1.2;
}
.ex-cell-title { font-size: 7pt; color: #222; margin-top: 0.5mm; line-height: 1.2; }
.ex-cell-venue { font-size: 7pt; color: #000; margin-top: 0.8mm; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2px; }
.ex-cell-inv { font-size: 6.5pt; color: #333; margin-top: 0.5mm; font-style: italic; line-height: 1.15; }
.ex-cell-block + .ex-cell-block { margin-top: 1.5mm; padding-top: 1.2mm; border-top: 1px dotted #999; }
.ex-cell-empty { color: #cbd5e1; font-size: 7pt; }

.ex-foot {
  margin-top: auto;
  padding-top: 8mm;
  display: flex; justify-content: space-between; align-items: flex-end;
  font-size: 8pt;
}
.ex-foot-sig { font-size: 8.5pt; line-height: 1.4; }
.ex-foot-sig .role { font-family: 'Poppins', Arial, sans-serif; font-weight: 700; color: #000; }
.ex-foot-sig .name { font-style: italic; text-decoration: underline; color: #000; }

@media print {
  @page { size: A4 landscape; margin: 0; }
  .ex-sheet { box-shadow: none; margin: 0; page-break-after: always; }
  .ex-sheet:last-child { page-break-after: auto; }
}

/* ============================================================
   USERS HUB JUMP CARDS (users/list.html)
   ============================================================ */
.us-jump-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
  margin: 20px 0;
}

.us-jump-card {
  background: #fff;
  border: 1px solid var(--fpu-border);
  border-radius: 14px;
  padding: 22px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  position: relative;
  overflow: hidden;
  text-decoration: none;
}

.us-jump-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, #065f46, #f59e0b);
}

.us-jump-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.10);
  border-color: rgba(6, 95, 70, 0.3);
}

.ujc-icon {
  font-size: 2rem;
  margin-bottom: 4px;
}

.us-jump-card h3 {
  font-family: 'Poppins', sans-serif;
  font-size: 1.05rem;
  color: #0f172a;
  margin: 0;
}

.us-jump-card p {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.55;
  margin: 0;
  flex: 1;
}

.ujc-arrow {
  font-family: 'Poppins', sans-serif;
  font-size: 12.5px;
  font-weight: 700;
  color: #f59e0b;
  margin-top: 8px;
}

/* ============================================================
   END
   ============================================================ */