{
    "name":  "fpu-school-system",
    "version":  "1.0.0",
    "description":  "Federal Polytechnic Ugep — School Management System (PostgreSQL + Drizzle + Express 5)",
    "main":  "server.js",
    "type":  "commonjs",
    "engines":  {
                    "node":  "20.x"
                },
    "scripts":  {
                    "start":  "node server.js",
                    "start:prod":  "node db/migrate.js \u0026\u0026 node server.js",
                    "dev":  "node --watch server.js",
                    "migrate":  "node db/migrate.js",
                    "migrate:cli":  "node scripts/migrate.js",
                    "seed":  "node scripts/seed-massive.js",
                    "seed:bank":  "node scripts/seed-bank-details.js",
                    "reset:staff":  "node scripts/reset-staff-passwords.js",
                    "drizzle:generate":  "drizzle-kit generate",
                    "drizzle:push":  "drizzle-kit push",
                    "drizzle:studio":  "drizzle-kit studio",
                    "seed:hods":  "node scripts/seed-department-hods.js"
                },
    "keywords":  [
                     "fpu",
                     "fedpolyugep",
                     "school-management",
                     "postgresql",
                     "drizzle",
                     "express"
                 ],
    "author":  "Federal Polytechnic Ugep",
    "license":  "ISC",
    "dependencies":  {
                         "bcryptjs":  "^3.0.3",
                         "cors":  "^2.8.6",
                         "dotenv":  "^18.0.5",
                         "drizzle-orm":  "^0.45.3",
                         "express":  "^5.2.1",
                         "express-rate-limit":  "^8.7.0",
                         "helmet":  "^8.3.0",
                         "nodemailer":  "^10.0.15",
                         "pg":  "^8.23.1"
                     },
    "devDependencies":  {
                            "drizzle-kit":  "^0.31.11"
                        }
}
