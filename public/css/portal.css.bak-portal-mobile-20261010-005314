/* ---------- Dropdown ---------- */
.user-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 260px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 12px 40px rgba(0,0,0,.18), 0 4px 12px rgba(0,0,0,.08);
  border: 1px solid #e5e7eb;
  overflow: hidden;
  z-index: 999;
